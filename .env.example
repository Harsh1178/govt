# JanConnect Environment Configuration

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer Gmail Credentials (for email confirmation & resolution alerts)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Server Port
PORT=3001

# Optional: HuggingFace Inference API Token (for cloud Qwen2.5 fallback)
# HF_TOKEN=hf_your_token_here

# Optional: Ollama URL (if running Qwen2.5 via Ollama locally)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b
